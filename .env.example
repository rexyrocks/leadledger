# Set these in the process environment. No automatic .env loading.
LEADLEDGER_DB=server
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=leadgraph_demo
# FALKORDB_PASSWORD=
# Alternative: LEADLEDGER_DB=embedded (install .[local])
LEADLEDGER_DATA=./work/leadledger.rdb
# Test suite TCP mode (Windows or any existing FalkorDB server):
# LEADLEDGER_TEST_DB=server
# FALKORDB_TEST_HOST=127.0.0.1
# FALKORDB_TEST_PORT=6379
# FALKORDB_TEST_PASSWORD=

# Copy settings into your shell. Never commit a key.
LEADLEDGER_AGENTS=fixture
# To use the private Colab Qwen through Lounge:
# LEADLEDGER_AGENTS=qwen
# QWEN_TRANSPORT=relay
# QWEN_BASE_URL=https://qwen-lounge.piyochoudhary.workers.dev
# QWEN_API_KEY_FILE=/absolute/path/to/private/key-file
# QWEN_MODEL_ID=Qwen3.8-27B-Q4_K_M
# Direct local llama.cpp alternative: QWEN_TRANSPORT=openai
# QWEN_BASE_URL=http://127.0.0.1:8766/v1
