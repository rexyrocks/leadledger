        "outreach_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "lead_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "approval_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "verification_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "draft": {
          "$ref": "#/$defs/Draft"
        },
        "idempotency_key": {
          "type": "string",
          "format": "uuid"
        },
        "gate_decision": {
          "$ref": "#/$defs/GateDecision"
        }
      }
    },
    "SenderResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outreach_id",
        "status",
        "mode",
        "message_hash",
        "simulated"
      ],
      "properties": {
        "outreach_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "status": {
          "const": "logged"
        },
        "mode": {
          "const": "log_only"
        },
        "message_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "simulated": {
          "const": true
        }
      }
    },
    "ErrorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "VERSION_CONFLICT",
            "INVALID_STATE",
            "COMMAND_REUSED",
            "COMMAND_IN_PROGRESS",
            "SEND_BLOCKED",
            "INVALID_INPUT",
            "NOT_FOUND",
            "DEPENDENCY_UNAVAILABLE",
            "ASSESSMENT_INVALID",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorBody"
        }
      }
    },
    "SourceList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Source"
          }
        }
      }
    },
    "Health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "graph",
        "execution_mode",
        "model_id",
        "sender_mode"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "degraded"
          ]
        },
        "graph": {
          "type": "string",
          "enum": [
            "connected",
            "unavailable"
          ]
        },
        "execution_mode": {
          "$ref": "#/$defs/ExecutionMode"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            },
            {
              "type": "null"
            }
          ]
        },
        "sender_mode": {
          "const": "log_only"
        }
      }
    }
  }
}
